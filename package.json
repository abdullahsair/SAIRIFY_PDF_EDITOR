{
  "name": "sairify-pdf-editor",
  "version": "1.0.0",
  "description": "Professional Adobe Acrobat-style PDF Reader and Editor",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "vite build && electron .",
    "build:exe": "vite build && electron-builder --win portable"
  },
  "keywords": [
    "pdf",
    "editor",
    "acrobat"
  ],
  "author": "abdullahsair",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "electron": "^45.2.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.sairify.pdfeditor",
    "productName": "SAIRIFY PDF Editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
